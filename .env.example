# Stream Chat (get from https://dashboard.getstream.io)
REACT_APP_STREAM_CHAT_API_KEY=your_stream_api_key
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_app_secret

# Token endpoint — defaults to /api/stream-token via dev proxy
REACT_APP_STREAM_CHAT_TOKEN_URL=/api/stream-token

# Firebase (web config — safe to expose in frontend)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Server (SERVER_PORT avoids clashing with Create React App's PORT)
SERVER_PORT=3001
FIREBASE_PROJECT_ID=your_project_id

# Optional: Firebase Admin service account JSON (single line) for token verification
# Download from Firebase Console > Project Settings > Service Accounts
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
